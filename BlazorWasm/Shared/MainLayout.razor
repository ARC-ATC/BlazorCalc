@inherits LayoutComponentBase

<div class="app-layout">
    <header class="app-header">
        <a class="brand" href="" aria-label="Exam Time Calculator home">
            <span class="brand-mark" aria-hidden="true">
                <span class="brand-hand brand-hand-hour"></span>
                <span class="brand-hand brand-hand-minute"></span>
            </span>
            <span class="brand-copy">
                <strong>ExamTime</strong>
                <span>Calculator</span>
            </span>
        </a>

        <div class="header-actions">
            <span class="browser-badge">
                <span class="browser-badge-dot"></span>
                Runs locally
            </span>

            <button type="button"
                    class="theme-toggle"
                    @onclick="ToggleTheme"
                    aria-pressed="@isDarkTheme"
                    aria-label="@(isDarkTheme ? "Switch to light mode" : "Switch to dark mode")">
                <span class="theme-toggle-icon" aria-hidden="true">@(isDarkTheme ? "☀" : "☾")</span>
                <span class="theme-toggle-label">@(isDarkTheme ? "Light" : "Dark")</span>
            </button>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>
